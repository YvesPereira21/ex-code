spring.application.name={{ config.name }}

{% if config.database.value == 'postgresql' %}
spring.datasource.url=jdbc:postgresql://localhost:5432/{{ config.name | replace('-', '_') }}
spring.datasource.username=postgres
spring.datasource.password=postgres
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
{% elif config.database.value == 'mysql' %}
spring.datasource.url=jdbc:mysql://localhost:3306/{{ config.name | replace('-', '_') }}?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=root
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
{% elif config.database.value == 'sqlite' %}
spring.datasource.url=jdbc:h2:mem:{{ config.name | replace('-', '_') }}db;DB_CLOSE_DELAY=-1
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.h2.console.enabled=true
spring.jpa.hibernate.ddl-auto=update
{% endif %}
spring.jpa.show-sql=true
